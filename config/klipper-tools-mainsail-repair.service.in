[Unit]
Description=Build and repair the Klipper Tools page in Mainsail
After=network-online.target moonraker.service klipper-calibration-wizard.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
EnvironmentFile=@ENV_FILE@
Environment="PATH=@BUILD_PATH@"
Environment="NPM_CONFIG_CACHE=@MAINSAIL_STATE@/npm-cache"
ExecStart="@PROJECT_DIR@/.venv/bin/python" -m calibration_wizard.mainsail_build --root "@MAINSAIL_DIR@" --state "@MAINSAIL_STATE@" --template "@PROJECT_DIR@/integrations/mainsail/Tools.vue"
TimeoutStartSec=50min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MAINSAIL_DIR@ @MAINSAIL_STATE@
